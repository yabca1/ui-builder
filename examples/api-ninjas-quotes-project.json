  "credentials": [
    {
      "id": "api-ninjas-key",
      "name": "API Ninjas Key",
      "value": "GovzwmRJbALpEvIy4tltfO6qUFcmIphh3BaDpYov"
    }
  ],
  "integrations": [
    {
      "id": "api-ninjas",
      "name": "API Ninjas",
      "baseUrl": "https://api.api-ninjas.com",
      "authConfig": {
        "type": "apiKey",
        "credentialId": "api-ninjas-key",
        "headerName": "X-Api-Key"
      },
      "loggingLevel": "basic"
    }
  ],
  "apiPaths": [
    {
      "id": "quotes",
      "name": "Quotes",
      "integrationId": "api-ninjas",
      "path": "/v2/quotes",
      "method": "GET",
      "requestSchema": [
        {
          "name": "categories",
          "type": "string",
          "required": false,
          "defaultValue": "success,wisdom"
        },
        {
          "name": "exclude_categories",
          "type": "string",
          "required": false
        },
        {
          "name": "author",
          "type": "string",
          "required": false
        },
        {
          "name": "work",
          "type": "string",
          "required": false
        }
      ],
      "responseSchema": [
        {
          "name": "0.quote",
          "type": "string",
          "required": true
        },
        {
          "name": "0.author",
          "type": "string",
          "required": true
        },
        {
          "name": "0.work",
          "type": "string",
          "required": false
        },
        {
          "name": "0.categories",
          "type": "array",
          "required": true
        }
      ]
    }
  ],
  "screens": [
    {
      "id": "home",
      "name": "Home",
      "nodes": [
        {
          "id": "root",
          "type": "column",
          "props": {},
          "style": {
            "padding": 16,
            "gap": {
              "type": "theme",
              "token": "md"
            },
            "backgroundColor": {
              "type": "theme",
              "token": "background"
            }
          },
          "children": [
            {
              "id": "heading",
              "type": "heading",
              "props": {
                "text": "API Ninjas Quotes",
                "level": 1
              },
              "style": {
                "color": {
                  "type": "theme",
                  "token": "text"
                }
              }
            },
            {
              "id": "intro",
              "type": "text",
              "props": {
                "text": "Tap the button to fetch a quote from API Ninjas."
              },
              "style": {
                "color": {
                  "type": "theme",
                  "token": "mutedText"
                }
              }
            },
            {
              "id": "quote-card",
              "type": "card",
              "props": {
                "title": "Quote",
                "description": "API response"
              },
              "style": {
                "backgroundColor": {
                  "type": "theme",
                  "token": "card"
                },
                "borderColor": {
                  "type": "theme",
                  "token": "border"
                },
                "gap": 12
              },
              "children": [
                {
                  "id": "quote-text",
                  "type": "text",
                  "props": {
                    "text": "{quote}"
                  },
                  "style": {
                    "fontSize": 18,
                    "fontWeight": "600",
                    "color": {
                      "type": "theme",
                      "token": "text"
                    }
                  }
                },
                {
                  "id": "author-text",
                  "type": "text",
                  "props": {
                    "text": "— {author}"
                  },
                  "style": {
                    "color": {
                      "type": "theme",
                      "token": "secondary"
                    }
                  }
                },
                {
                  "id": "categories-text",
                  "type": "text",
                  "props": {
                    "text": "Categories: {categories}"
                  },
                  "style": {
                    "fontSize": 12,
                    "color": {
                      "type": "theme",
                      "token": "mutedText"
                    }
                  }
                }
              ]
            },
            {
              "id": "fetch-quote-button",
              "type": "button",
              "props": {
                "label": "Fetch Quote"
              },
              "style": {
                "backgroundColor": {
                  "type": "theme",
                  "token": "primary"
                },
                "textColor": "#052e16"
              },
              "events": {
                "onPress": {
                  "type": "invokeApi",
                  "integrationId": "api-ninjas",
                  "pathId": "quotes",
                  "requestMappings": [
                    {
                      "parameter": "categories",
                      "sourceType": "static",
                      "sourceValue": "success,wisdom"
                    }
                  ],
                  "responseMappings": [
                    {
                      "responsePath": "0.quote",
                      "targetVariable": "quote"
                    },
                    {
                      "responsePath": "0.author",
                      "targetVariable": "author"
                    },
                    {
                      "responsePath": "0.categories",
                      "targetVariable": "categories"
                    }
                  ],
                  "onLoading": {
                    "type": "showToast",
                    "message": "Fetching quote..."
                  },
                  "onLoaded": {
                    "type": "showToast",
                    "message": "Quote loaded"
                  },
                  "onError": {
                    "type": "showToast",
                    "message": "Quote request failed"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
